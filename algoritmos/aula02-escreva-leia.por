programa
{
	inteiro valor
	cadeia nome
	funcao inicio()
	{

		// Instrução escreva -> Escreve dados na tela do computador
		escreva(15)
		escreva("Pizza")
		escreva("TI39")
		
		/* Instrução leia -> lê valores ou teclas do teclado 
		e armazena em uma variável na memória */
		leia(valor)
		leia(nome)
		
	}
}
