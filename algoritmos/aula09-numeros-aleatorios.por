programa
{
	inclua biblioteca Util --> u

	inteiro numero
	
	funcao inicio()
	{
		escreva("Gerar números aleatórios\n")
		numero = u.sorteia(1, 10)
		escreva("O número gerado foi: ", numero)
	}
}
