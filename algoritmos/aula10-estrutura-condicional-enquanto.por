programa
{
	/* Imprimir na tela os números de 1 a 10, usando a estrutura de repetição enquanto. */
	inteiro num
	funcao inicio()
	{
		num = 1
		enquanto (num <= 10) {
			escreva(num + "\n")
			num++ //num = num +1
		}
	}
}
