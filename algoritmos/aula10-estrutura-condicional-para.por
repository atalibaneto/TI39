programa
{
	/* Imprimir na tela os números de 1 a 10, usando a estrutura de repetição para. */

	inteiro contador
	
	funcao inicio()
	{
		para (contador = 1; contador <= 10; contador++) {
			escreva(contador,"\n")
		}
	}
}
