programa
{
	inteiro matriz[5][5]
	
	funcao inicio()
	{
		matriz[0][0] = 60
		escreva("Valor: ", matriz[0][0], "\n")

		escreva("Digite um número: ")
		leia(matriz[1][2])
		escreva("\nValor: ", matriz[1][2], "\n")
	}
}
